<!DOCTYPE html>
<html lang="te">
<head><link rel="manifest" href="./manifest.json">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#b00020">
<title>AP13 NEWS - నిజం జనం ముందుకు</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f4f6;color:#222}
header{background:#b00020;color:white;padding:20px 14px;text-align:center}
header h1{margin:0;font-size:28px}
header p{margin:7px 0 0}
nav{background:#222;color:white;padding:12px;text-align:center}
main{max-width:800px;margin:auto;padding:14px}
h2{color:#b00020}
.news{background:white;padding:14px;margin:12px 0;border-radius:9px;box-shadow:0 2px 7px #ddd}
.news a{color:#b00020;text-decoration:none;font-weight:bold}
.news p{line-height:1.6}
footer{background:#222;color:white;text-align:center;padding:18px}
</style>
</head>
<body>
<header>
<h1>AP13 NEWS</h1>
<p>నిజం జనం ముందుకు....</p>
</header>
<nav>ఆంధ్రప్రదేశ్ | తెలంగాణ | జాతీయం | ప్రపంచం</nav>
<main>
<h2>తాజా వార్తలు</h2>
<div id="news">వార్తలు లోడ్ అవుతున్నాయి...</div>
</main>
<footer>© AP13 NEWS | నిజం జనం ముందుకు....</footer>
<script>
function showNews(data){
 const posts=data.feed.entry||[];
 const box=document.getElementById("news");
 box.innerHTML="";
 if(!posts.length){box.textContent="ప్రస్తుతం వార్తలు లేవు.";return;}
 posts.forEach(post=>{
  const title=post.title.$t;
  const link=post.link.find(x=>x.rel==="alternate").href;
  const date=new Date(post.published.$t).toLocaleDateString("te-IN");
  const item=document.createElement("div");
  item.className="news";
  const heading=document.createElement("a");
  heading.href=link;
  heading.target="_blank";
  heading.rel="noopener";
  heading.textContent=title;
  const time=document.createElement("p");
  time.textContent="తేదీ: "+date;
  item.append(heading,time);
  box.appendChild(item);
 });
}
</script>
<script src="https://wwwap13news.blogspot.com/feeds/posts/default?alt=json-in-script&max-results=25&callback=showNews"></script>
</body>
</html>
